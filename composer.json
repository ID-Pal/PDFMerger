{
    "name": "id-pal/pdfmerger",
    "description": "PDFMerger for PHP",
    "keywords": ["PHP", "PDF"],
    "homepage": "https://github.com/ID-Pal/PDFMerger",
    "type": "library",
    "license": "LGPL-3.0-or-later",
    "authors": [{
        "name": "Myo Kyaw Htun",
        "homepage": "https://github.com/myokyawhtun"
    },{
        "name": "Rolando Guedes",
        "homepage": "https://github.com/rguedes"
    }],
    "require": {
        "php": ">=5.2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-0": {
            "PDFMerger": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IdPal\\PDFMerger\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "dev"
}
